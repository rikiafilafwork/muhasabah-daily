// Skema basis data Muhasabah Daily. Lihat ARCHITECTURE.md bagian 6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  light
  dark
  system
}

enum Color {
  emerald
  sky
  violet
  amber
  rose
  slate
}

/// Urutan nilai penting: dipakai untuk mengurutkan tugas (high paling atas).
enum Priority {
  none
  low
  medium
  high
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  city         String?
  latitude     Float?
  longitude    Float?
  timezone     String   @default("Asia/Jakarta")
  theme        Theme    @default(system)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  events        Event[]
  projects      Project[]
  tasks         Task[]
  habits        Habit[]
  goals         Goal[]

  @@map("users")
}

/// Refresh token disimpan ter-hash. Satu `familyId` = satu rantai rotasi sejak login.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- Fase 2

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  location    String?
  startAt     DateTime @db.Timestamptz(3)
  endAt       DateTime @db.Timestamptz(3)
  allDay      Boolean  @default(false)
  color       Color    @default(emerald)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([userId, endAt])
  @@map("events")
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     Color    @default(sky)
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, archived, position])
  @@map("projects")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  notes       String?
  priority    Priority  @default(none)
  /// Tanggal jatuh tempo (lokal pengguna).
  dueDate     DateTime? @db.Date
  /// Tanggal lokal saat tugas ditandai fokus. `focusToday` = (focusDate == hari ini).
  focusDate   DateTime? @db.Date
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt, dueDate])
  @@index([userId, projectId])
  @@index([userId, focusDate])
  @@map("tasks")
}

/// Library habit bawaan, diisi oleh seeder. Baca-saja.
model HabitTemplate {
  id          String  @id
  name        String
  category    String
  description String?
  reference   String?
  position    Int     @default(0)

  habits Habit[]

  @@map("habit_templates")
}

model Habit {
  id         String   @id @default(cuid())
  userId     String
  templateId String?
  name       String
  color      Color    @default(emerald)
  position   Int      @default(0)
  active     Boolean  @default(true)
  /// Tanggal mulai (lokal). Hari aktif untuk konsistensi dihitung sejak tanggal ini.
  startDate  DateTime @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template HabitTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs     HabitLog[]
  goals    GoalHabit[]

  @@index([userId, active, position])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  /// Tanggal lokal pengguna.
  date      DateTime @db.Date
  done      Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  target      Int
  unit        String?
  manualValue Int       @default(0)
  /// Log habit tertaut dihitung sejak tanggal ini (lokal).
  startDate   DateTime  @db.Date
  deadline    DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits GoalHabit[]

  @@index([userId, createdAt])
  @@map("goals")
}

model GoalHabit {
  goalId  String
  habitId String
  weight  Int    @default(1)

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
  @@index([habitId])
  @@map("goal_habits")
}
