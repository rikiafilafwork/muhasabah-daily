// Skema basis data Muhasabah Daily. Lihat ARCHITECTURE.md bagian 6.

// Prisma 7: klien TypeScript dibuat ke src/generated/prisma (tidak di-commit) dan
// dikompilasi bersama kode API. Format CommonJS mengikuti build NestJS.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// URL koneksi diatur di prisma.config.ts (CLI) dan driver adapter (runtime).
datasource db {
  provider = "postgresql"
}

enum Theme {
  light
  dark
  system
}

enum Color {
  emerald
  sky
  violet
  amber
  rose
  slate
}

/// Urutan nilai penting: dipakai untuk mengurutkan tugas (high paling atas).
enum Priority {
  none
  low
  medium
  high
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  city            String?
  latitude        Float?
  longitude       Float?
  timezone        String   @default("Asia/Jakarta")
  theme           Theme    @default(system)
  /// Sholat wajib yang diingatkan lewat Web Push saat waktunya masuk (fajr, dhuhr, ...).
  prayerReminders String[] @default([])
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  events            Event[]
  projects          Project[]
  tasks             Task[]
  habits            Habit[]
  goals             Goal[]
  focusSessions     FocusSession[]
  dhikrLogs         DhikrLog[]
  memorizationPlans MemorizationPlan[]
  journalEntries    JournalEntry[]
  lectureNotes      LectureNote[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

/// Refresh token disimpan ter-hash. Satu `familyId` = satu rantai rotasi sejak login.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- Fase 2

model Event {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  location        String?
  startAt         DateTime  @db.Timestamptz(3)
  endAt           DateTime  @db.Timestamptz(3)
  allDay          Boolean   @default(false)
  color           Color     @default(emerald)
  /// Menit sebelum mulai untuk notifikasi; null = tanpa pengingat.
  reminderMinutes Int?
  /// startAt dikurangi reminderMinutes, agar penjadwal cukup memakai indeks.
  remindAt        DateTime? @db.Timestamptz(3)
  reminderSentAt  DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([userId, endAt])
  @@index([remindAt])
  @@map("events")
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     Color    @default(sky)
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, archived, position])
  @@map("projects")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  notes       String?
  priority    Priority  @default(none)
  /// Tanggal jatuh tempo (lokal pengguna).
  dueDate     DateTime? @db.Date
  /// Tanggal lokal saat tugas ditandai fokus. `focusToday` = (focusDate == hari ini).
  focusDate   DateTime? @db.Date
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]

  @@index([userId, completedAt, dueDate])
  @@index([userId, projectId])
  @@index([userId, focusDate])
  @@map("tasks")
}

/// Library habit bawaan, diisi oleh seeder. Baca-saja.
model HabitTemplate {
  id          String  @id
  name        String
  category    String
  description String?
  reference   String?
  position    Int     @default(0)

  habits Habit[]

  @@map("habit_templates")
}

model Habit {
  id         String   @id @default(cuid())
  userId     String
  templateId String?
  name       String
  color      Color    @default(emerald)
  position   Int      @default(0)
  active     Boolean  @default(true)
  /// Tanggal mulai (lokal). Hari aktif untuk konsistensi dihitung sejak tanggal ini.
  startDate  DateTime @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template HabitTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs     HabitLog[]
  goals    GoalHabit[]

  @@index([userId, active, position])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  /// Tanggal lokal pengguna.
  date      DateTime @db.Date
  done      Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  target      Int
  unit        String?
  manualValue Int       @default(0)
  /// Log habit tertaut dihitung sejak tanggal ini (lokal).
  startDate   DateTime  @db.Date
  deadline    DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits GoalHabit[]

  @@index([userId, createdAt])
  @@map("goals")
}

model GoalHabit {
  goalId  String
  habitId String
  weight  Int    @default(1)

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
  @@index([habitId])
  @@map("goal_habits")
}

// ---------------------------------------------------------------- Fase 3

enum FocusStatus {
  completed
  cancelled
}

model FocusSession {
  id             String      @id @default(cuid())
  userId         String
  taskId         String?
  label          String?
  startedAt      DateTime    @db.Timestamptz(3)
  endedAt        DateTime    @db.Timestamptz(3)
  /// Tanggal lokal saat sesi dimulai, untuk ringkasan harian.
  date           DateTime    @db.Date
  plannedSeconds Int
  focusedSeconds Int
  status         FocusStatus
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("focus_sessions")
}

enum DhikrGroup {
  pagi
  petang
  tidur
}

/// Konten dzikir, diisi oleh seeder. Baca-saja.
model DhikrItem {
  id          String     @id
  group       DhikrGroup
  position    Int
  title       String
  arabic      String
  latin       String
  translation String
  reference   String
  note        String?
  repeat      Int        @default(1)

  logs DhikrLog[]

  @@index([group, position])
  @@map("dhikr_items")
}

model DhikrLog {
  id        String   @id @default(cuid())
  userId    String
  dhikrId   String
  /// Tanggal lokal pengguna.
  date      DateTime @db.Date
  count     Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dhikr DhikrItem @relation(fields: [dhikrId], references: [id], onDelete: Cascade)

  @@unique([userId, dhikrId, date])
  @@index([userId, date])
  @@map("dhikr_logs")
}

// ---------------------------------------------------------------- Fase 5

/// Data Al-Qur'an, diisi oleh `seed:quran` dari AlQuran Cloud. Baca-saja.
model Surah {
  id             Int    @id
  nameArabic     String
  nameLatin      String
  nameMeaning    String
  revelationType String
  ayahCount      Int

  ayahs             Ayah[]
  memorizationPlans MemorizationPlan[]

  @@map("surahs")
}

model Ayah {
  /// Nomor global 1–6236.
  id            Int    @id
  surahId       Int
  numberInSurah Int
  juz           Int
  page          Int
  arabic        String
  latin         String
  translationId String
  /// URL audio di sumbernya; file audio tidak disimpan.
  audioUrl      String

  surah Surah @relation(fields: [surahId], references: [id], onDelete: Cascade)

  @@unique([surahId, numberInSurah])
  @@map("ayahs")
}

model MemorizationPlan {
  id            String   @id @default(cuid())
  userId        String
  surahId       Int
  fromAyah      Int
  toAyah        Int
  title         String?
  listenRepeat  Int
  reciteRepeat  Int
  connectRepeat Int
  currentStage  Int      @default(0)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  surah  Surah               @relation(fields: [surahId], references: [id], onDelete: Restrict)
  stages MemorizationStage[]

  @@index([userId, archived, createdAt])
  @@map("memorization_plans")
}

enum StageKind {
  listen
  recite
  connect
}

model MemorizationStage {
  id       String    @id @default(cuid())
  planId   String
  position Int
  kind     StageKind
  fromAyah Int
  toAyah   Int
  repeat   Int

  plan MemorizationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, position])
  @@map("memorization_stages")
}

enum PolishStatus {
  none
  pending
  done
  failed
}

model JournalEntry {
  id              String       @id @default(cuid())
  userId          String
  /// Tanggal lokal pengguna.
  date            DateTime     @db.Date
  rawText         String
  polishedText    String?
  polishStatus    PolishStatus @default(none)
  polishError     String?
  /// Hash teks asli yang dirapikan; berbeda dari hash sekarang berarti versi rapi sudah usang.
  polishedRawHash String?
  polishedAt      DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("journal_entries")
}

model LectureNote {
  id          String   @id @default(cuid())
  userId      String
  title       String
  speaker     String?
  source      String?
  /// Tanggal lokal kajian.
  date        DateTime @db.Date
  tags        String[]
  /// Dokumen TipTap (JSON). Dirender oleh editor, tidak pernah sebagai HTML mentah.
  content     Json
  /// Teks polos untuk pencarian dan pratinjau.
  contentText String
  /// Rujukan ayat yang ditemukan di dokumen: [{ surahId, from, to }].
  ayahRefs    Json     @default("[]")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("lecture_notes")
}

/// Langganan Web Push satu perangkat/browser. Endpoint unik; pindah akun di browser yang sama
/// memindahkan langganan ke pengguna baru.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
