# Salin ke .env lalu isi nilainya. Jangan commit .env.
# Mode container (`docker compose up`): .env opsional; secret JWT dibuat otomatis bila kosong,
# DATABASE_URL/REDIS_URL diatur oleh docker-compose.yml.
# Buat secret acak dengan: openssl rand -base64 48

NODE_ENV=development
PORT=3000

# --- Wajib ---
DATABASE_URL=postgresql://muhasabah:muhasabah@localhost:5432/muhasabah
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Opsional ---
ALADHAN_BASE_URL=https://api.aladhan.com/v1
# Sumber data Al-Qur'an (seed:quran) dan audio murottal
ALQURAN_CLOUD_BASE_URL=https://api.alquran.cloud/v1
QURAN_AUDIO_BASE_URL=https://cdn.islamic.network/quran/audio/128/ar.alafasy

# AI Polish jurnal. Mati bila AI_PROVIDER atau AI_API_KEY kosong.
# AI_PROVIDER=anthropic memakai Claude (Anthropic API) dengan kunci milikmu sendiri.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=10
AI_MAX_INPUT_CHARS=8000
# Pengingat sholat dan agenda (Web Push). Mati bila kunci kosong.
# Buat kunci dengan: pnpm --filter api vapid:generate  (container membuatnya otomatis)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak pengelola untuk layanan push; Safari menolak alamat yang tidak valid
VAPID_SUBJECT=mailto:admin@example.com
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT=10
# auto: cookie sesi bertanda Secure hanya bila diakses lewat HTTPS
COOKIE_SECURE=auto

# --- Khusus docker compose ---
# Port aplikasi di host dan alamat publiknya
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080
# false: jangan impor data Al-Qur'an saat container api start
SEED_QURAN=true
LOG_LEVEL=info

# Kredensial container PostgreSQL (docker-compose.yml)
POSTGRES_USER=muhasabah
POSTGRES_PASSWORD=muhasabah
POSTGRES_DB=muhasabah
